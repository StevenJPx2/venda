{
  "name": "@venda/core",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-neutral Venda CMS: one Web-standard request handler over pluggable database, storage and cache services.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./content": "./src/content/index.ts",
    "./cloudflare": "./src/adapters/cloudflare.ts",
    "./node": "./src/adapters/node.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && effect-language-service diagnostics --project tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@venda/content": "workspace:*",
    "@venda/contract": "workspace:*",
    "@venda/schema": "workspace:*",
    "@venda/richtext": "workspace:*",
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "5.9.3",
    "vitest": "latest"
  }
}
