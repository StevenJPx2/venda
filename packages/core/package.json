{
  "name": "@venda/core",
  "version": "0.1.0",
  "private": true,
  "description": "Venda's domain in Effect: content sync into the index and the public reads, over services the host provides.",
  "type": "module",
  "exports": {
    "./auth": "./src/auth/index.ts",
    "./content": "./src/content/index.ts",
    "./database": "./src/database.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && effect-language-service diagnostics --project tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@gdp-ts/core": "0.1.0",
    "@venda/content": "workspace:*",
    "@venda/contract": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261005.1",
    "@effect/sql-sqlite-node": "4.0.1",
    "@types/node": "26.6.3",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
