{
  "name": "@venda/server",
  "version": "0.1.0",
  "private": true,
  "description": "Venda's host: a Nitro app that serves the core on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @venda/admin-app build && nitro build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && effect-language-service diagnostics --project tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@effect/sql-d1": "4.0.1",
    "@gdp-ts/core": "0.1.0",
    "@venda/contract": "workspace:*",
    "@venda/core": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "effect": "4.0.1",
    "nitro": "3.0.260903-beta"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261005.1",
    "@effect/sql-sqlite-node": "4.0.1",
    "@types/node": "26.6.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "unstorage": "1.17.5",
    "vitest": "5.0.2",
    "wrangler": "4.136.3"
  }
}
