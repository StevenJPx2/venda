{
  "name": "@venda/server",
  "version": "0.1.0",
  "private": true,
  "description": "Venda's host: a Nitro app that serves the core on Cloudflare Workers or Node.",
  "type": "module",
  "scripts": {
    "build": "nitro build",
    "build:node": "NITRO_PRESET=node nitro build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && effect-language-service diagnostics --project tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@venda/contract": "workspace:*",
    "@venda/core": "workspace:*",
    "db0": "0.4.1",
    "effect": "4.0.1",
    "nitro": "3.0.260903-beta",
    "unstorage": "1.17.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260922.1",
    "@types/node": "26.6.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2",
    "wrangler": "4.136.3"
  }
}
