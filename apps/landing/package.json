{
  "name": "@venda/landing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "nuxt prepare",
    "deploy": "nuxt build && wrangler deploy",
    "deploy:venda": "VENDA_WRANGLER=$PWD/venda.wrangler.json pnpm --filter @venda/server build && pnpm --filter @venda/server exec wrangler deploy --config .output/server/wrangler.json"
  },
  "dependencies": {
    "@nuxt/ui": "4.11.2",
    "@venda/nuxt": "workspace:*",
    "@vue/shared": "3.5.43",
    "nuxt": "4.6.0",
    "tailwindcss": "4.3.3",
    "vue": "3.5.43",
    "@venda/richtext": "workspace:*"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "latest",
    "typescript": "5.9.3",
    "vue-tsc": "latest",
    "wrangler": "latest"
  }
}
