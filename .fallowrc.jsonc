{
  // Fallow gates packages on the new architecture (docs/architecture.md), the
  // same list as oxlint.config.ts; it grows as each package is rebuilt.
  "entry": [
    // Nitro entry points: the server entry, runtime plugins, the config, and
    // the platform modules chosen through the `#venda/platform` alias.
    "packages/server/server/server.ts",
    "packages/server/server/plugins/*.ts",
    "packages/server/nitro.config.ts",
    "packages/server/src/platforms/*.ts",
    "packages/*/eslint.config.mjs"
  ],
  "ignorePatterns": ["tools/oxlint/anti-slop/**", "**/.output/**", "**/.output-node/**", "**/.wrangler/**"],
  "boundaries": {
    "zones": [
      { "name": "contract", "patterns": ["packages/contract/**"] },
      { "name": "core", "patterns": ["packages/core/**"] },
      { "name": "server", "patterns": ["packages/server/**"] }
    ],
    // Dependencies only point down: the server hosts the core, both speak the contract.
    "rules": [
      { "from": "contract", "allow": [] },
      { "from": "core", "allow": ["contract"] },
      { "from": "server", "allow": ["core", "contract"] }
    ]
  }
}
