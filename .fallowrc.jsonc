{
  // Fallow gates the packages in tools/new-architecture.json, the same list as oxlint.config.ts.
  "entry": [
    // Nitro entry points: the server entry, runtime plugins, the config, and
    // the per-preset target modules chosen through the `#venda/target` alias.
    "packages/server/server/server.ts",
    "packages/server/server/plugins/*.ts",
    "packages/server/nitro.config.ts",
    "packages/server/src/targets/*.ts",
    "packages/core/drizzle.config.ts",
    // Type-level tests: type-checked mistakes that must not compile, never imported.
    "packages/*/test/mistakes.ts",
    "packages/*/eslint.config.mjs"
  ],
  // Nitro's generated storage code imports chokidar for the fs driver's watcher,
  // so no source file does; Nitro requires the app to list it.
  "ignoreDependencies": ["chokidar"],
  "ignorePatterns": ["tools/oxlint/anti-slop/**", "**/.output/**", "**/.output-node/**", "**/.wrangler/**"],
  "boundaries": {
    "zones": [
      { "name": "contract", "patterns": ["packages/contract/**"] },
      { "name": "content", "patterns": ["packages/content/**"] },
      { "name": "core", "patterns": ["packages/core/**"] },
      { "name": "server", "patterns": ["packages/server/**"] },
      { "name": "admin-sdk", "patterns": ["packages/admin/**"] },
      { "name": "views", "patterns": ["packages/views-core/**"] },
      { "name": "pages", "patterns": ["packages/pages-core/**"] },
      { "name": "preset", "patterns": ["packages/preset-default/**"] },
      { "name": "admin-app", "patterns": ["apps/admin/app/**"] }
    ],
    // Dependencies only point down: the server hosts the core, both speak the
    // contract and read files through content.
    "rules": [
      { "from": "contract", "allow": [] },
      { "from": "content", "allow": [] },
      { "from": "core", "allow": ["contract", "content"] },
      { "from": "server", "allow": ["core", "contract", "content"] },
      { "from": "admin-sdk", "allow": ["contract"] },
      { "from": "views", "allow": ["admin-sdk", "contract"] },
      { "from": "pages", "allow": ["admin-sdk", "contract"] },
      { "from": "preset", "allow": ["views", "pages"] },
      { "from": "admin-app", "allow": ["admin-sdk", "preset", "contract"] }
    ]
  }
}
